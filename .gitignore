# Environment variables (NEVER commit these)
# EXPO_PUBLIC_* 값은 앱 번들에 평문으로 박히지만, 파일 자체는 절대 커밋하지 않는다
.env*
!.env.example

# Node
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# 검증 산출물 (verify-M*.mjs 스크린샷 · adb 캡처 · 테스트용 스크린타임 이미지)
# 로그인 화면·실제 스크린타임 캡처에는 개인정보가 담긴다
.verify/
shot.png
sample*.png

# Native build output (prebuild 산출물 — 커밋하지 않는다)
ios/
android/

# 서명·자격증명 (EAS 서버 관리 방식을 쓴다 — 로컬 파일이 생기면 그건 실수다)
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.pem
*.cer
*.certSigningRequest
*.key
*.mobileprovision
*.provisionprofile
credentials.json
google-services.json
GoogleService-Info.plist

# Firebase — 서비스 계정 키는 앱 레포에 존재해선 안 된다 (웹 서버 전용)
.firebase/
*firebase-adminsdk*.json
serviceAccountKey.json
firebase-debug.log
firestore-debug.log

# 로그 (ID 토큰·기기 식별자가 찍힐 수 있다)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

