# Offlo_APP 환경변수 템플릿 — 이 파일을 .env.local 로 복사해 값을 채운다
# EXPO_PUBLIC_* 는 앱 번들에 평문으로 박힌다. 공개 전제인 값만 둔다.

# Firebase 클라이언트 config — 웹(../Offlo/web/.env.local)과 같은 프로젝트
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 웹 API Routes 도메인
EXPO_PUBLIC_API_BASE_URL=https://offlo2.vercel.app

# Google 로그인 — Firebase 콘솔 > Authentication > Google > 웹 SDK 구성 > 웹 클라이언트 ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
